<?xml version="1.0" encoding="utf-8"?>
<!-- Fugueti: Google Play version. Removes what Play policy restricts and this version never uses:
     photo/video access (file search and the wallpaper preview button are off on Play) and the
     crash log uploader's foreground service (Play collects crashes itself in Android vitals). -->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />

    <application>
        <service android:name="app.lawnchair.bugreport.UploaderService" tools:node="remove" />
    </application>

</manifest>
